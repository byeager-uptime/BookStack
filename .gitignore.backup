# BookStack Backup .gitignore
# This file excludes sensitive data and large/temporary files from backups

# Environment and sensitive configuration
.env
.env.*
*.key

# Vendor directories (can be restored with composer/npm)
/vendor
/node_modules

# IDE and editor files
/.vscode
/.idea
.phpstorm.meta.php
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build and compiled files
/public/dist
/public/css
/public/js
/public/build/
npm-debug.log
yarn-error.log
yarn.lock
package-lock.json

# Storage - exclude some directories but keep structure
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/debugbar
/storage/clockwork/*
!/storage/clockwork/.gitkeep

# Uploads - keep these as they contain user data
# /storage/uploads/images
# /storage/uploads/files

# Database backups will be handled separately
/storage/backups/*.sql
/storage/backups/*.sql.gz

# Testing and development
.phpunit.result.cache
/coverage
phpstan.neon
.phpactor.json

# Other
*.zip
*.tar.gz
_ide_helper.php
/bin
nbproject
.buildpath
.project
.nvmrc
.settings/
webpack-stats.json
esbuild-meta.json

# Homestead
Homestead.yaml
Homestead.json

# Temporary files
*.tmp
*.temp
*.cache